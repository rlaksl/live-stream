# 실제 값은 .env.local(로컬)과 Vercel 환경변수에 넣는다. 이 파일에는 값을 넣지 않는다.

# 서비스 주소 (토스 결제 성공/실패 리다이렉트에 사용)
APP_URL=http://localhost:3000

# Supabase: Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LiveKit Cloud: Settings → Keys
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 녹화 저장소 (S3 호환): Supabase Storage → Settings → S3 Connection
RECORDING_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
RECORDING_S3_REGION=ap-northeast-2
RECORDING_S3_BUCKET=recordings
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=

# 토스페이먼츠 테스트 키: 개발자센터 → API 키 → API 개별 연동 키 (결제창용, 위젯 키 아님)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_
TOSS_SECRET_KEY=test_sk_

# 테스트 계정 바로 로그인용 비밀번호 (README에 공개되는 평가용 값)
TEST_ACCOUNT_PASSWORD=

# Vercel 크론 호출 검증용 (Vercel이 자동으로 Authorization 헤더에 넣는다)
CRON_SECRET=
